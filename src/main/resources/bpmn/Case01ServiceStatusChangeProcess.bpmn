      <outgoing>_A4972B34-BDAF-4023-BEC9-66180E1642BD</outgoing>
      <ioSpecification id="_55014F12-E2D7-4CBA-8023-362292DB7674">
        <dataInput id="_D10F0DC6-3A48-4461-8FC3-1777DC7684C7" name="model" drools:dtype="String" itemSubjectRef="_47C65749-D77F-4DEE-90CB-3B035999072D" />
        <dataInput id="_2087C816-150C-4EDB-8580-88A6DC9CCDC3" name="fileName" drools:dtype="String" itemSubjectRef="_47C65749-D77F-4DEE-90CB-3B035999072D" />
        <dataInput id="_7DF19037-67B7-4ADB-B8EB-651185145807" name="namespace" drools:dtype="String" itemSubjectRef="_47C65749-D77F-4DEE-90CB-3B035999072D" />
        <dataInput id="_70E937FA-E139-4374-8AD4-35D7C95402A9" name="Request" drools:dtype="java.util.Map" itemSubjectRef="_7B228945-40A6-491E-B361-E6F9573B9156" />
        <dataOutput name="Result" id="_26D119C9-B11C-4C9D-818B-6FE42C011381" drools:dtype="java.util.Map" itemSubjectRef="_7B228945-40A6-491E-B361-E6F9573B9156" />
        <inputSet id="_94367A39-EDBA-4CC9-9AA3-FB488AC03C36">
