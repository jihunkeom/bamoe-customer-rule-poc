  <decision name="NormalizedNumber" id="_8DD8C4E9-F1B6-4B84-B718-C42E32E8EA7C">
    <variable id="_2D3A492F-BB03-45E5-AEF0-783E7B5E64B2" typeRef="string" name="NormalizedNumber" />
    <informationRequirement id="_0FF28BBD-1B37-4B3D-BFC9-240D645C54AF">
      <requiredInput href="#_A04CEC74-E485-4530-90CC-4CEDAAEF1FF8" />
    </informationRequirement>
    <literalExpression id="_158BE914-64BC-4D4D-9A1B-E0BE49B17446" typeRef="string" label="NormalizedNumber">
      <text>if Request.csmAux004Result = &quot;DENIED&quot;
then if Request.mmsOriginNumber = null
     then null
     else replace(Request.mmsOriginNumber, &quot;^\\s+|\\s+$&quot;, &quot;&quot;)
else null</text>
    </literalExpression>
  </decision>
  <decision name="OriginPrefix" id="_F8297E7E-F78E-4305-BB9B-2D3F858BA539">
    <variable id="_9A97FCF9-0E1E-4D4B-BA94-3ACD9FF6B9F4" typeRef="string" name="OriginPrefix" />
    <informationRequirement id="_AE93305C-786E-4352-9A54-C4646E5D49AB">
      <requiredDecision href="#_8DD8C4E9-F1B6-4B84-B718-C42E32E8EA7C" />
    </informationRequirement>
    <literalExpression id="_79FB564A-5A4C-4A01-9CDE-5630E0613CBB" typeRef="string" label="OriginPrefix">
      <text>if NormalizedNumber != null
   and string length(NormalizedNumber) &gt;= 3
then substring(NormalizedNumber, 1, 3)
else null</text>
    </literalExpression>
  </decision>
