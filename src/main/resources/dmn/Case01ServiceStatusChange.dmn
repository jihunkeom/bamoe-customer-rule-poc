  <decision name="RequestValid" id="_295ED636-7B67-4625-A901-7C26F2C8ABF1">
    <variable name="RequestValid" id="_FB6FC646-6674-4244-97BA-10EF2D1B04EC" typeRef="boolean" />
    <informationRequirement id="_32B9EB9C-548A-40C0-85D6-4E457E3BC56A">
      <requiredInput href="#_1D4520C0-7617-4347-B955-DD8AB4F31932" />
    </informationRequirement>
    <literalExpression id="_AC305DA5-0EF2-4328-A43B-44A0E3393371" typeRef="boolean" label="RequestValid">
      <text>Request.serviceStatusChangeCode != null
and Request.serviceStatusChangeCode != &quot;&quot;
and Request.serviceDetailClassCode != null
and Request.serviceDetailClassCode != &quot;&quot;
and Request.authorityLookupState != null
and Request.promotionLookupState != null</text>
    </literalExpression>
  </decision>
  <decision name="AuthorityCheckRequired" id="_E0A2C467-9967-45A5-AA02-56D054639F92">
    <variable id="_D881309E-BF38-49C9-92C6-41E8659F008E" typeRef="boolean" name="AuthorityCheckRequired" />
    <informationRequirement id="_4FAE34B8-CF6B-48FA-A35B-6809878995F1">
      <requiredDecision href="#_295ED636-7B67-4625-A901-7C26F2C8ABF1" />
    </informationRequirement>
    <informationRequirement id="_45DDA91D-A6E4-4BE8-B5C7-881DBA01D76E">
      <requiredInput href="#_1D4520C0-7617-4347-B955-DD8AB4F31932" />
    </informationRequirement>
    <literalExpression id="_0048CDD9-29E4-4DA8-9E84-32B7639A4EFB" typeRef="boolean" label="AuthorityCheckRequired">
      <text>RequestValid
and Request.serviceDetailClassCode = &quot;CA&quot;
and list contains(
  [&quot;F1&quot;, &quot;F2&quot;, &quot;FR&quot;],
  Request.serviceStatusChangeCode
)</text>
    </literalExpression>
  </decision>
  <decision name="PromotionCheckRequired" id="_6E161A46-C964-4074-BD46-1A9DCB13213F">
    <variable id="_304BF2D9-8708-4D1F-93DF-1E48E25BB80E" typeRef="boolean" name="PromotionCheckRequired" />
    <informationRequirement id="_A832976F-9C90-4876-A7DB-6A59D1F27203">
      <requiredDecision href="#_E0A2C467-9967-45A5-AA02-56D054639F92" />
    </informationRequirement>
    <informationRequirement id="_496B08EC-707B-4F4A-84BE-5665ACDD6A97">
      <requiredInput href="#_1D4520C0-7617-4347-B955-DD8AB4F31932" />
    </informationRequirement>
    <literalExpression id="_F3A3543F-FD68-401E-ADC7-769A490803F9" typeRef="boolean" label="PromotionCheckRequired">
      <text>AuthorityCheckRequired
and Request.authorityLookupState = &quot;COMPLETED&quot;
and Request.ordAux227Result = &quot;GRANTED&quot;
and Request.serviceStatusChangeCode = &quot;F1&quot;</text>
    </literalExpression>
  </decision>
