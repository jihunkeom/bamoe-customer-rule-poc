  <decision name="RequestValid" id="_0B6F035F-1C57-40FF-9D4E-C03164687E13">
    <variable id="_287EB2EA-FA04-4358-A68D-39B386B51B48" typeRef="boolean" name="RequestValid" />
    <informationRequirement id="_9F8FB2C7-15C9-4E15-9D8D-ED9762A94F4E">
      <requiredInput href="#_702B2847-5934-42F6-BB65-152D32753444" />
    </informationRequirement>
    <literalExpression id="_7B29D89D-0C34-4584-B86B-35D70CB8856E" typeRef="boolean" label="RequestValid">
      <text>Request.serviceCode != null
and Request.serviceCode != &quot;&quot;
and Request.serviceTypeCode != null
and Request.serviceTypeCode != &quot;&quot;
and Request.authorityLookupState != null</text>
    </literalExpression>
  </decision>
  <decision name="AuthorityCheckRequired" id="_1691294E-2A69-478E-97C1-186402EFEE3B">
    <variable id="_4FD76A4D-2950-46F4-87E1-6C6084B21379" typeRef="boolean" name="AuthorityCheckRequired" />
    <informationRequirement id="_399ADFD5-A3F4-4B2F-B160-BB073A3A231D">
      <requiredInput href="#_702B2847-5934-42F6-BB65-152D32753444" />
    </informationRequirement>
    <informationRequirement id="_9D67D21A-990F-4269-84F3-5244F017A6DE">
      <requiredDecision href="#_0B6F035F-1C57-40FF-9D4E-C03164687E13" />
    </informationRequirement>
    <literalExpression id="_248FF9DA-BE06-45FB-BCBD-E5598E6079C9" typeRef="boolean" label="AuthorityCheckRequired">
      <text>RequestValid
and Request.serviceCode = &quot;P&quot;
and Request.serviceTypeCode = &quot;72&quot;</text>
    </literalExpression>
  </decision>
